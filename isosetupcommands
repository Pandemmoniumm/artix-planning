cfdisk
mkfs.fat -F 32 /dev/vda1
mkfs.btrfs /dev/vda2
mount /dev/vda2 /mnt
btrfs subvolume create /dev/vda2 /mnt/@
btrfs subvolume create /dev/vda2 /mnt/@home
btrfs subvolume create /dev/vda2 /mnt/@cache
btrfs subvolume create /dev/vda2 /mnt/@log
btrfs subvolume create /dev/vda2 /mnt/@snapshots
btrfs subvolume create /dev/vda2 /mnt/@tmp
umount /mnt
mkdir -p /mnt/home /mnt/var /mnt/var/cache /mnt/var/log /mnt/var/tmp /mnt/.snapshots
mount -o noatime,compress=zstd:3,space_cache=v2,ssd,subvol=@ /dev/vda2 /mnt
mount -o noatime,compress=zstd:3,space_cache=v2,ssd,subvol=@home /dev/vda2 /mnt/home
mount -o noatime,compress=zstd:3,space_cache=v2,ssd,subvol=@log /dev/vda2 /mnt/var/log
mount -o noatime,compress=zstd:3,space_cache=v2,ssd,subvol=@cache /dev/vda2 /mnt/var/cache
mount -o noatime,compress=zstd:3,space_cache=v2,ssd,subvol=@snapshots /dev/vda2 /mnt
sv up chrony
basestrap /mnt base base-devel runit elogind-runit linux-firmware
fstabgen -U /mnt >> /mnt/etc/fstab
artix-chroot /mnt
ln -sf /usr/share/zoneinfo/Africa/Johannesburg /etc/localtime
hwclock --systohc
